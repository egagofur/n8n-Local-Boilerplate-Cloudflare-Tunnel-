# =============================================================================
# n8n local boilerplate — copy to .env and customize before first start:
#   cp .env.example .env
# Generate a strong encryption key:
#   openssl rand -hex 32
# Generate a strong DB password:
#   openssl rand -hex 16
# =============================================================================

# --- Compose profiles ---------------------------------------------------------
# tunnel       = Quick Tunnel (ephemeral *.trycloudflare.com)  [default]
# named-tunnel = Stable hostname via CLOUDFLARE_TUNNEL_TOKEN
# (empty)      = Local only — no public exposure
COMPOSE_PROFILES=tunnel

# --- Images (pinned; override to upgrade) -------------------------------------
N8N_IMAGE=docker.n8n.io/n8nio/n8n:2.31.7
CLOUDFLARED_IMAGE=cloudflare/cloudflared:2026.7.3
POSTGRES_IMAGE=postgres:16-alpine

# --- Database -----------------------------------------------------------------
POSTGRES_DB=n8n
POSTGRES_USER=n8n
POSTGRES_PASSWORD=change_this_to_a_secure_password

# --- n8n general --------------------------------------------------------------
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
GENERIC_TIMEZONE=Asia/Jakarta

# Public webhook base URL (include trailing slash).
# start.sh fills this automatically when using Quick Tunnel (COMPOSE_PROFILES=tunnel).
# For named-tunnel or production, set this to your stable HTTPS URL yourself.
WEBHOOK_URL=

# Required: used to encrypt credentials stored in the database.
# If you lose this key, existing credentials cannot be decrypted.
N8N_ENCRYPTION_KEY=change_this_to_a_random_32byte_hex_string

# --- Optional n8n tuning ------------------------------------------------------
N8N_DIAGNOSTICS_ENABLED=false
N8N_PERSONALIZATION_ENABLED=false
# false = local http://localhost works; set true only if you only use HTTPS UI
N8N_SECURE_COOKIE=false
# 1 when n8n sits behind Cloudflare Tunnel / reverse proxy (start.sh sets this for tunnel mode)
N8N_PROXY_HOPS=0
EXECUTIONS_DATA_PRUNE=true
EXECUTIONS_DATA_MAX_AGE=168

# --- Named Cloudflare Tunnel (only if COMPOSE_PROFILES=named-tunnel) ----------
# Create a tunnel in Cloudflare Zero Trust, copy the token, set WEBHOOK_URL to
# your stable hostname (e.g. https://n8n-hooks.example.com/).
CLOUDFLARE_TUNNEL_TOKEN=
